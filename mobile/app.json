{
  "expo": {
    "name": "힘내개",
    "slug": "himnaegae",
    "scheme": "himnaegae",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-v2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.himnaegae.cafe"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EC",
        "foregroundImage": "./assets/android-icon-foreground-v2.png",
        "monochromeImage": "./assets/android-icon-monochrome-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.himnaegae.cafe"
    },
    "web": {
      "favicon": "./assets/icon-v2.png"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#EF7045",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EC",
          "image": "./assets/android-icon-foreground-v2.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "546c3da5-11d6-46cd-9735-43b2acafde3a"
      }
    },
    "owner": "shinjaehyeong"
  }
}
